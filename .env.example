# Panel
PORT=3000
HOST=0.0.0.0
TP_DATA_DIR=./data
TP_SECRET=change-me-to-a-long-random-string

# Default admin (created only on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Node daemon defaults
DAEMON_PORT=8081
DAEMON_TOKEN=

# Cloudflare Tunnel (optional, can also be set in the admin panel)
# Leave empty to use a quick tunnel (no account needed)
CF_TUNNEL_TOKEN=

# Public panel URL, used by the status command and status page
PUBLIC_URL=http://localhost:3000
