{
  "name": "terrypanel",
  "version": "1.0.0",
  "description": "A lightweight game and bot hosting panel for any VPS (no KVM required).",
  "main": "panel/server.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
